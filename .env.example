# Copy this file to .env and fill in the values. Do not commit .env.

# The bot is written for the Vikunja API v2 (API v1 is not supported).
# Give only the server address (Vikunja service name and port inside the Docker network).
# Do not add the API path: the bot adds /api/v2/ itself.
Vikunja__Uri=http://vikunja:3456
Vikunja__Token=tk_xxxxxxxxxxxxxxxxxxxxxxxx

Telegram__Token=123456789:ABCDEF...
Telegram__AllowedUserIds=123456789
