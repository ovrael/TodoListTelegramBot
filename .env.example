# Copy this file to .env and fill in the values. Do not commit .env.

# Vikunja service name and port inside the Docker network. The trailing slash is required.
Vikunja__Uri=http://vikunja:3456/api/v1/
Vikunja__Token=tk_xxxxxxxxxxxxxxxxxxxxxxxx

